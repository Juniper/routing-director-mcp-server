    "/api/v1/orgs/{org_id}/syslog/messages/count": {
      "get": {
        "tags": [
          "#observability Events"
        ],
        "summary": "Get_aggregated_count_of_syslog_messages_by_severity",
        "description": "Returns the count of syslog messages grouped by severity level for the specified time range and filters. Use this for dashboard statistics and overview metrics",
        "operationId": "Get_aggregated_count_of_syslog_messages_by_severity",
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "description": "Organization ID (UUID format). All syslog messages are scoped to devices within this organization.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "5f133def-0150-47d8-a0bc-8e7c2a969aac"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "description": "Time duration for filtering messages. Mutually exclusive with start/end parameters. If neither duration nor start/end is provided, defaults to last 1 hour",
            "style": "form",
            "explode": true,
            "schema": {
              "pattern": "^\\d+[smhd]$",
              "type": "string",
              "default": "1h",
              "example": "15m"
            },
            "examples": {
              "15_minutes": {
                "summary": "Last 15 minutes",
                "value": "15m"
              },
              "2_hours": {
                "summary": "Last 2 hours",
                "value": "2h"
              },
              "7_days": {
                "summary": "Last 7 days",
                "value": "7d"
              }
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of syslog messages to return per page",
            "style": "form",
            "explode": true,
            "schema": {
              "maximum": 1000.0,
              "minimum": 1.0,
              "type": "integer",
              "format": "int32",
              "default": 100
            }
          },
          {
            "name": "start",
            "in": "query",
            "description": "Start timestamp (Unix epoch) from which to fetch syslog messages",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "end",
            "in": "query",
            "description": "End timestamp (Unix epoch) till which to fetch syslog messages",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "severity",
            "in": "query",
            "description": "Filter messages at or above the specified severity level. Severity hierarchy (lowest to highest): Warn < Error < Critical < Alert < Emergency. For example, 'Error' returns Error, Critical, Alert, and Emergency messages.",
            "style": "form",
            "explode": true,
            "schema": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/severity2"
                },
                {
                  "description": "Filter messages at or above the specified severity level. Severity hierarchy (lowest to highest): Warn < Error < Critical < Alert < Emergency. For example, 'Error' returns Error, Critical, Alert, and Emergency messages."
                }
              ]
            }
          },
          {
            "name": "mac",
            "in": "query",
            "description": "MAC address of the device to filter by. Can take multiple MAC addresses separated by comma",
            "style": "form",
            "explode": true,
            "schema": {
              "pattern": "^([0-9A-Fa-f]{12})(,([0-9A-Fa-f]{12}))*$",
              "type": "string"
            }
          },
          {
            "name": "site_id",
            "in": "query",
            "description": "To filter by site-id, can also take comma-separated list of site IDs (UUIDs)",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message",
            "in": "query",
            "description": "Search in message column of the syslog messages. Use quotes for exact match/contains, asterisk for startswith, no quotes for fuzzy search",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "string",
              "example": "\"exited\""
            },
            "examples": {
              "contains": {
                "summary": "Contains exact string 'exited' (case-sensitive)",
                "value": "\"exited\""
              },
              "startswith": {
                "summary": "Starts with string 'exit' ",
                "value": "\"exit*\""
              },
              "fuzzy_search": {
                "summary": "Fuzzy search for similar text (most flexible)",
                "value": "connection timeout"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/ApiV1OrgsSyslogMessagesCountResponse"
                    },
                    {
                      "example": {
                        "results": [
                          {
                            "severity": "Error",
                            "count": 72
                          },
                          {
                            "severity": "Warn",
                            "count": 28
                          }
                        ],
                        "start": 1760056483,
                        "end": 1760058283,
                        "limit": 15,
                        "distinct": "severity",
                        "total": 2
                      }
                    }
                  ]
                },
                "examples": {
                  "with_data": {
                    "summary": "Response with syslog message counts",
                    "description": "Example response when syslog messages are found and counted by severity",
                    "value": {
                      "results": [
                        {
                          "severity": "Error",
                          "count": 72
                        },
                        {
                          "severity": "Warn",
                          "count": 28
                        }
                      ],
                      "start": 1760056483,
                      "end": 1760058283,
                      "limit": 15,
                      "distinct": "severity",
                      "total": 2
                    }
                  },
                  "no_data": {
                    "summary": "Response with no syslog messages",
                    "description": "Example response when no syslog messages are found matching the query criteria",
                    "value": {
                      "results": [],
                      "start": 1759451647,
                      "end": 1760056447,
                      "limit": 15,
                      "distinct": "severity",
                      "total": 0
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid parameters or malformed query",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiV1OrgsSyslogMessagesCount400Error1"
